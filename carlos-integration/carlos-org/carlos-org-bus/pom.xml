<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.carlos.org</groupId>
    <artifactId>carlos-org</artifactId>
    <version>${revision}</version>
  </parent>

  <packaging>jar</packaging>

  <artifactId>carlos-org-bus</artifactId>


  <dependencies>
    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-starter-openapi</artifactId>
    </dependency>
    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-starter-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-starter-log</artifactId>
    </dependency>
    <!--
      操作日志落库链路：@Log → LogStorage → MQ(audit:log) → carlos-audit → ClickHouse。
      仅依赖 carlos-audit-api（契约 + 桥接实现），不依赖 carlos-audit-bus（那是服务本体）。
      桥接自动配置在 starter-log + starter-mq 同时存在时生效，两者缺一则退回只打应用日志。
    -->
    <dependency>
      <groupId>com.carlos.audit</groupId>
      <artifactId>carlos-audit-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-starter-mq</artifactId>
    </dependency>
    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-starter-mybatis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-starter-sms</artifactId>
    </dependency>
    <!-- 引入test依賴 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.carlos.org</groupId>
      <artifactId>carlos-org-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.carlos.auth</groupId>
      <artifactId>carlos-auth-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.carlos.system</groupId>
      <artifactId>carlos-system-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.idev.excel</groupId>
      <artifactId>fastexcel</artifactId>
      <exclusions>
        <!-- 强制使用 carlos-dependencies 统一管理的 Apache POI 版本 -->
        <exclusion>
          <groupId>org.apache.poi</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- 显式声明 POI，确保 fastexcel 排除传递依赖后版本统一 -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
    </dependency>
    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-starter-web</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>false</skipTests>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
