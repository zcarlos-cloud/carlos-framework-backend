<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.carlos.devkit</groupId>
    <artifactId>carlos-devkit</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>carlos-devkit-bus</artifactId>
  <description>
    开发工具平台业务实现模块
    模板管理（DB 托管 + 在线编辑 + 版本）、受管数据源、代码生成引擎、工程生成引擎
    对应设计文档：DESIGN-20261006-开发工具平台功能设计
  </description>

  <dependencies>
    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-starter-mybatis</artifactId>
    </dependency>

    <!-- 安全模块（用户上下文、方法级权限） -->
    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-starter-security</artifactId>
    </dependency>

    <!-- 加密组件（数据源密码 SM4 加解密） -->
    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-starter-encrypt</artifactId>
    </dependency>

    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-starter-openapi</artifactId>
    </dependency>

    <dependency>
      <groupId>com.carlos.devkit</groupId>
      <artifactId>carlos-devkit-api</artifactId>
    </dependency>

    <!-- 模板渲染引擎（FreeMarker 2.3.34，与 Spring Boot 4.x 管理版本一致） -->
    <dependency>
      <groupId>org.freemarker</groupId>
      <artifactId>freemarker</artifactId>
    </dependency>

    <!-- 工具库：FileUtil / StrUtil / NamingCase / Db / SimpleDataSource -->
    <dependency>
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-all</artifactId>
    </dependency>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
    </dependency>

    <!-- 目标库 JDBC 驱动：代码生成器连接目标数据库读取元数据 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
