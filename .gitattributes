# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source code
*.java text diff=java eol=lf
*.kt text diff=kotlin eol=lf
*.groovy text eol=lf
*.scala text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.json text eol=lf

# Documentation
*.md text diff=markdown eol=lf
*.txt text eol=lf
*.rst text eol=lf
*.adoc text eol=lf
READ* text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf

# Config files
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.gitconfig text eol=lf

# Binary files
*.jar binary
*.war binary
*.ear binary
*.zip binary
*.tar binary
*.tar.gz binary
*.tar.bz2 binary
*.tar.xz binary
*.gz binary
*.bz2 binary
*.xz binary
*.7z binary
*.rar binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.webp binary

# Fonts
*.ttf binary
*.eot binary
*.otf binary
*.woff binary
*.woff2 binary

# Office documents
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
*.pdf binary

# Executables
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Compiled files
*.class binary
