<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>com.carlos</groupId>
    <artifactId>carlos-spring-boot</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>carlos-spring-boot-starter-apm</artifactId>

  <name>carlos-spring-boot-starter-apm</name>
  <description>
    Carlos APM 渐进式可观测性模块
    基础层：MDC 日志关联（开箱即用）
    链路层：Micrometer Tracing + Brave（内置）
    增强层：SkyWalking APM（可选，自动检测）
  </description>

  <dependencies>
    <!-- ==================== Carlos 核心模块 ==================== -->
    <dependency>
      <groupId>com.carlos</groupId>
      <artifactId>carlos-spring-boot-core</artifactId>
    </dependency>

    <!-- ==================== Layer 2: 链路追踪（内置，始终可用） ==================== -->
    <!-- Spring Boot Brave 自动配置（创建 brave.Tracer / brave.Tracing Bean） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-tracing-brave</artifactId>
    </dependency>

    <!-- Micrometer Tracing + Brave 桥接 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-brave</artifactId>
    </dependency>

    <!-- Spring Boot Actuator（指标监控） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- ==================== Layer 3: SkyWalking 增强（可选） ==================== -->
    <!-- SkyWalking Toolkit - 追踪 API -->
    <dependency>
      <groupId>org.apache.skywalking</groupId>
      <artifactId>apm-toolkit-trace</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- SkyWalking Logback 集成 -->
    <dependency>
      <groupId>org.apache.skywalking</groupId>
      <artifactId>apm-toolkit-logback-1.x</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- ==================== AOP 支持 ==================== -->
    <!-- AspectJ - TraceTag 注解切面 -->
    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
    </dependency>

    <!-- Spring Expression - SpEL 解析 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-expression</artifactId>
    </dependency>

    <!-- ==================== Web 层（可选） ==================== -->
    <!-- Servlet API - MDC Filter -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- ==================== Feign 传播（可选） ==================== -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-openfeign-core</artifactId>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>

    <!-- ==================== 工具依赖 ==================== -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

  </dependencies>

</project>
